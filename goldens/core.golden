type type ListenerOpts struct{Passive bool}
type type MouseEvent struct{baseEvent; ClientX float64; ClientY float64; Button int; Meta bool; Ctrl bool; Shift bool; Alt bool; target syscall/js.Value; currentTarget syscall/js.Value}
