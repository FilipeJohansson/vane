package layouts

import (
	"fmt"
	"strings"

	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"

	"vane-page/src/components"
	"vane-page/src/pages/docs"
)

func docsSidebarLink(t docs.Topic, onNavigate func()) core.Node {
	to := "/docs"
	if t.Slug != "" {
		to = "/docs/" + t.Slug
	}
	return (
		<li>
			{router.ActiveLink(router.ActiveLinkProps{
				LinkProps:   router.LinkProps{To: to, HTMLProps: core.HTMLProps{Class: "docs-nav-link", OnClick: func(core.MouseEvent) { onNavigate() }}},
				ActiveClass: "docs-nav-link--active",
				Exact:       t.Slug == "",
			}, t.Title)}
		</li>
	)
}

// docsSidebarGroupTitle appends a live "(done/total)" fraction to the
// Tutorial category.
func docsSidebarGroupTitle(category string) string {
	if category != "Tutorial" {
		return category
	}
	return fmt.Sprintf("%s (%d/%d)", category, docs.TutorialCompletedCount(), len(docs.TutorialUnitSlugs))
}

// docsSidebarGroup renders one collapsible category: toggle button with a
// rotating chevron, topic list shown only while open.
func docsSidebarGroup(category string, open bool, onToggle func(), onNavigate func()) core.Node {
	topics := docs.TopicsIn(category)
	links := make([]core.Node, len(topics))
	for i, t := range topics {
		links[i] = docsSidebarLink(t, onNavigate)
	}
	cls := "docs-nav-group"
	if open {
		cls = "docs-nav-group docs-nav-group--open"
	}
	return (
		<div className={cls}>
			<button type="button" className="docs-nav-group-toggle" aria-expanded={open} onClick={func(core.MouseEvent) { onToggle() }}>
				<span className="docs-nav-group-chevron" aria-hidden="true">{components.Icon("chevron-right")}</span>
				<span className="docs-nav-group-title">{docsSidebarGroupTitle(category)}</span>
			</button>
			{if open {
				<ul className="docs-nav-list">
					{links...}
				</ul>
			} else {
				<span />
			}}
		</div>
	)
}

// docsSidebarGroups renders every Category in the active Section as its own
// accordion group. Open/closed is derived (open iff current page's category,
// unless overridden), never synced via an Effect Set - an earlier version
// did that and hung on cold boot even with the read Untracked.
func docsSidebarGroups(activeSection *core.Signal[string], catOverride *core.Signal[map[string]bool], onToggle func(string), onNavigate func()) core.Node {
	components.RefreshIcons()
	currentCat := categoryOfPath(router.Path().Get())
	cats := docs.CategoriesIn(activeSection.Get())
	overrides := catOverride.Get()
	nodes := make([]core.Node, len(cats))
	for i, c := range cats {
		cat := c
		open := cat == currentCat
		if v, ok := overrides[cat]; ok {
			open = v
		}
		nodes[i] = docsSidebarGroup(cat, open, func() { onToggle(cat) }, onNavigate)
	}
	return core.Fragment(nodes...)
}

// sectionTab is one entry in the top Tutorial/Guide/CLI/Reference switcher.
func sectionTab(section string, active string, onSelect func(string)) core.Node {
	cls := "docs-section-tab"
	if section == active {
		cls = "docs-section-tab docs-section-tab--active"
	}
	return (
		<button type="button" role="tab" aria-selected={section == active} className={cls} onClick={func(core.MouseEvent) { onSelect(section) }}>
			{section}
		</button>
	)
}

func sectionTabs(active *core.Signal[string], onSelect func(string)) core.Node {
	cur := active.Get()
	tabs := make([]core.Node, len(docs.Sections))
	for i, s := range docs.Sections {
		tabs[i] = sectionTab(s, cur, onSelect)
	}
	return (
		<div className="docs-section-tabs" role="tablist" aria-label="Documentation sections">
			{tabs...}
		</div>
	)
}

// categoryOfPath resolves the manifest Category for whatever /docs/<slug>
// path is currently loaded, defaulting to the overview's own category for
// anything unrecognized (e.g. mid-navigation transients).
func categoryOfPath(path string) string {
	slug := strings.TrimPrefix(strings.TrimPrefix(path, "/docs"), "/")
	if t, ok := docs.TopicBySlug(slug); ok {
		return t.Category
	}
	return "Getting Started"
}

// setupReadingProgress watches window scroll and reports how far down the
// page the user has scrolled, as a 0-100 percentage. Called once from a ref
// callback: DocsLayout is a router.Layout shell, it stays mounted across
// /docs sub-navigation, so this listener lives for the whole docs session
// instead of being torn down per page.
func setupReadingProgress(progress *core.Signal[float64]) {
	update := func() {
		scrollTop := core.ScrollY()
		scrollHeight, clientHeight := core.DocumentHeight()
		max := scrollHeight - clientHeight
		pct := 100.0
		if max > 0 {
			pct = scrollTop / max * 100
			switch {
			case pct < 0:
				pct = 0
			case pct > 100:
				pct = 100
			}
		}
		progress.Set(pct)
	}

	// Deferred a tick for the same reason as setupScrollSpy in widgets.vane:
	// the ref'd element isn't attached to the document yet at this point, so
	// scrollHeight/clientHeight would still reflect the pre-mount layout.
	core.NextTick(update)

	core.OnWindowEvent("scroll", func(core.Event) { update() }, core.ListenerOpts{Passive: true})
}

func sidebarClass(open bool) string {
	if open {
		return "docs-sidebar"
	}
	return "docs-sidebar docs-sidebar--closed"
}

func toggleClass(open bool) string {
	if open {
		return "docs-sidebar-toggle docs-sidebar-toggle--open"
	}
	return "docs-sidebar-toggle"
}

// DocsLayout is the persistent shell for the whole /docs section: the
// sidebar nav stays mounted across sub-navigation, only router.Outlet()'s
// content swaps.
func DocsLayout() core.Node {
	progress := core.NewSignal(0.0)
	// Mobile-only collapsed panel, see docs-sidebar-toggle/--closed in
	// DocsLayout.css. On desktop the toggle button is display:none and
	// docs-sidebar--closed has no effect, so this signal is inert there.
	sidebarOpen := core.NewSignal(false)
	toggleSidebar := func() { sidebarOpen.Set(!sidebarOpen.Get()) }
	closeSidebar := func() { sidebarOpen.Set(false) }

	activeSection := core.NewSignal("Guide")
	// catOverride holds only EXPLICIT user toggles, keyed by category. A
	// category absent from this map uses its derived default (open iff it's
	// the current page's category - see docsSidebarGroups); toggling flips
	// away from whatever that effective state currently is.
	catOverride := core.NewSignal(map[string]bool{})
	toggleCat := func(cat string) {
		effective := cat == categoryOfPath(router.Path().Get())
		m := catOverride.Get()
		if v, ok := m[cat]; ok {
			effective = v
		}
		next := make(map[string]bool, len(m)+1)
		for k, v := range m {
			next[k] = v
		}
		next[cat] = !effective
		catOverride.Set(next)
	}
	selectSection := func(s string) { activeSection.Set(s) }

	// Keeps the section tabs in sync with real navigation (sidebar link
	// clicks, search result picks, browser back/forward) - independent of
	// selectSection above, which only fires on a direct tab click and never
	// touches the route. The accordion groups don't need an equivalent
	// effect: docsSidebarGroups derives open/closed from router.Path()
	// itself wherever it's read, reactively, with no signal Set in between.
	core.Effect(func() func() {
		cat := categoryOfPath(router.Path().Get())
		activeSection.Set(docs.SectionOf(cat))
		return nil
	})

	search := newSearchCtrl()
	setupSearchShortcut(search)

	core.Effect(func() func() {
		components.RefreshIcons()
		return nil
	})

	return (
		<>
			<div className="docs-progress-track" ref={func(el core.Node) { setupReadingProgress(progress) }}>
				<div className="docs-progress-fill" style={core.Style{Width: fmt.Sprintf("%.2f%%", progress.Get())}} />
			</div>
			<div className="docs-shell-glow" aria-hidden="true" />
			<div className="docs-shell">
				<button
					type="button"
					className={toggleClass(sidebarOpen.Get())}
					aria-expanded={sidebarOpen.Get()}
					onClick={func(core.MouseEvent) { toggleSidebar() }}
				>
					Browse docs
					<span className="docs-sidebar-toggle-icon" aria-hidden="true">{components.Icon("chevron-down")}</span>
				</button>
				<nav className={sidebarClass(sidebarOpen.Get())} aria-label="Documentation">
					<div className="docs-sidebar-header">
						{searchTriggerButton(search)}
						{sectionTabs(activeSection, selectSection)}
					</div>
					<div className="docs-sidebar-scroll">
						{docsSidebarGroups(activeSection, catOverride, toggleCat, closeSidebar)}
					</div>
				</nav>
				<div className="docs-content-area">
					{router.Outlet()}
				</div>
			</div>
			{searchModal(search)}
			<div id="modal-root"></div>
		</>
	)
}
