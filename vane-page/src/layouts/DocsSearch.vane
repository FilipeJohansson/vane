package layouts

import (
	"fmt"
	"strings"

	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"

	"vane-page/src/components"
	"vane-page/src/pages/docs"
)

// searchShortcutLabel is the display-only hint text: the actual shortcut
// already answers to both Ctrl+K and Cmd+K (setupSearchShortcut), this just
// shows whichever one matches the reader's OS.
func searchShortcutLabel() string {
	if isMac() {
		return "⌘K"
	}
	return "Ctrl K"
}

func searchTriggerButton(ctrl *searchCtrl) core.Node {
	return (
		<button type="button" className="docs-search-trigger" onClick={func(core.MouseEvent) { ctrl.Open() }} aria-label="Search docs">
			<span className="docs-search-trigger-icon" aria-hidden="true">{components.Icon("search")}</span>
			<span className="docs-search-trigger-label">Search docs</span>
			<kbd className="docs-search-kbd">{searchShortcutLabel()}</kbd>
		</button>
	)
}

// searchResultID is the DOM id given to each result row, stable across
// re-renders since it's purely a function of flat index - arrow-key
// navigation uses it to scroll the newly active row into view.
func searchResultID(i int) string {
	return fmt.Sprintf("search-result-%d", i)
}

func searchResultRow(r docs.SearchResult, i int, active int, onSelect func()) core.Node {
	cls := "docs-search-result"
	if i == active {
		cls = "docs-search-result docs-search-result--active"
	}
	return (
		<li id={searchResultID(i)} key={r.RoutePath() + "#" + r.AnchorID} role="option" aria-selected={i == active}>
			<button type="button" className={cls} onClick={func(core.MouseEvent) { onSelect() }}>
				<div className="docs-search-result-container">
					<span className="docs-search-result-category">{r.Category}</span>
					<div className="docs-search-result-wrapper">
						<span className="docs-search-result-title docs-search-result-text-nowrap">{r.Title}</span>
						{if r.Heading != "" {
							<>
								<span className="docs-search-result-sub-icon"></span>
								<span className="docs-search-result-sub docs-search-result-text-nowrap">{r.Heading}</span>
							</>
						}}
					</div>
				</div>
				<span className="docs-search-result-select-icon">{components.Icon("corner-down-left")}</span>
			</button>
		</li>
	)
}

// searchResultGroup is every result under one Section header (Tutorial /
// Guide / CLI / Reference), shown once above everything found inside it.
type searchResultGroup struct {
	section string
	results []docs.SearchResult
}

// groupResultsBySection buckets results by their Section, preserving both
// each result's relative rank within its group and the order sections first
// appear in - Search's own title/heading/summary ranking still decides
// what's first within a group, grouping only decides which group comes
// first.
func groupResultsBySection(results []docs.SearchResult) []searchResultGroup {
	var order []string
	byName := map[string]*searchResultGroup{}
	for _, r := range results {
		sec := docs.SectionOf(r.Category)
		g, ok := byName[sec]
		if !ok {
			g = &searchResultGroup{section: sec}
			byName[sec] = g
			order = append(order, sec)
		}
		g.results = append(g.results, r)
	}
	groups := make([]searchResultGroup, len(order))
	for i, sec := range order {
		groups[i] = *byName[sec]
	}
	return groups
}

// flattenGroups re-linearizes grouped results back into the exact order
// they're rendered in, so a single flat "active" index (arrow-key nav) maps
// onto the right row regardless of grouping.
func flattenGroups(groups []searchResultGroup) []docs.SearchResult {
	var out []docs.SearchResult
	for _, g := range groups {
		out = append(out, g.results...)
	}
	return out
}

func searchResultGroupNode(g searchResultGroup, startIndex int, active int, onSelect func(docs.SearchResult) func()) core.Node {
	rows := make([]core.Node, len(g.results))
	for i, r := range g.results {
		idx := startIndex + i
		rows[i] = searchResultRow(r, idx, active, onSelect(r))
	}
	return (
		<li className="docs-search-group">
			<span className="docs-search-group-label">{g.section}</span>
			<ul className="docs-search-group-list">
				{rows...}
			</ul>
		</li>
	)
}

// searchModal renders the Ctrl/Cmd+K dialog. Combines the accessible-modal
// pattern (see Accessibility.vane's "Accessible modal, with Portal" section:
// Portal + FocusTrap via a callback ref, OnDispose registered synchronously
// inside it) with a click-outside-to-close backdrop, done via MouseEvent.IsSelfTarget()
// (target === currentTarget) on the backdrop's own OnClick.
func searchModal(ctrl *searchCtrl) core.Node {
	return core.Portal("#modal-root", func() core.Node {
		if !ctrl.open.Get() {
			return nil
		}

		// The trigger button's own search icon is picked up by DocsLayout's
		// mount-time RefreshIcons call, but this dialog (and its icon) is
		// only constructed the moment the modal opens, after that mount-time
		// call already ran, so it needs its own, same as Nav.vane's mobile
		// panel re-asks Lucide each time it reopens.
		components.RefreshIcons()

		groups := groupResultsBySection(docs.Search(ctrl.query.Get()))
		results := flattenGroups(groups)

		active := ctrl.active.Get()
		if active >= len(results) {
			active = len(results) - 1
		}
		if active < 0 {
			active = 0
		}

		selectResult := func(r docs.SearchResult) func() {
			return func() {
				ctrl.Close()
				to := r.RoutePath()
				if r.AnchorID != "" {
					to += "#" + r.AnchorID
				}
				router.Navigate(to)
			}
		}

		scrollActiveIntoView := func(i int) {
			// Deferred: active.Set below rebuilds the whole results list, which
			// would instantly undo a synchronous scroll here.
			core.NextTick(func() {
				container, ok := core.GetElementByID("docs-search-results")
				if !ok {
					return
				}
				el, ok := core.GetElementByID(searchResultID(i))
				if !ok {
					return
				}
				// Nudge scrollTop by the overflow amount only, not
				// core.ScrollIntoView (block:"start" always top-aligns).
				cr := core.BoundingRect(container)
				er := core.BoundingRect(el)
				raw := core.Unwrap(container)
				current := raw.Get("scrollTop").Float()
				switch {
				case er.Top < cr.Top:
					raw.Set("scrollTop", current-(cr.Top-er.Top))
				case er.Bottom > cr.Bottom:
					raw.Set("scrollTop", current+(er.Bottom-cr.Bottom))
				}
			})
		}

		moveActive := func(delta int) {
			if len(results) == 0 {
				return
			}
			next := ctrl.active.Get() + delta
			switch {
			case next < 0:
				next = 0
			case next >= len(results):
				next = len(results) - 1
			}
			ctrl.active.Set(next)
			scrollActiveIntoView(next)
		}

		groupNodes := make([]core.Node, len(groups))
		start := 0
		for i, g := range groups {
			groupNodes[i] = searchResultGroupNode(g, start, active, selectResult)
			start += len(g.results)
		}

		return (
			<div
				className="docs-search-backdrop"
				ref={func(el core.Node) {
					core.OnClick(el, func(e core.MouseEvent) {
						if e.IsSelfTarget() {
							ctrl.Close()
						}
					})
				}}
			>
				<div
					ref={func(el core.Node) {
						var untrap func()
						core.OnDispose(func() {
							if untrap != nil {
								untrap()
							}
						})
						core.NextTick(func() {
							untrap = core.FocusTrap(el)
						})
					}}
					role="dialog" aria-modal="true" aria-label="Search docs"
					className="docs-search-dialog"
					onKeyDown={func(e core.KeyEvent) {
						switch e.Key {
						case "Escape":
							ctrl.Close()
						case "ArrowDown":
							e.PreventDefault()
							moveActive(1)
						case "ArrowUp":
							e.PreventDefault()
							moveActive(-1)
						case "Enter":
							if active >= 0 && active < len(results) {
								e.PreventDefault()
								selectResult(results[active])()
							}
						}
					}}
				>
					<div className="docs-search-input-row">
						<span className="docs-search-input-icon" aria-hidden="true">{components.Icon("search")}</span>
						<input
							id="docs-search-input"
							name="search"
							type="text"
							className="docs-search-input"
							placeholder="Search docs..."
							aria-label="Search docs"
							value={ctrl.query.Get()}
							onInput={func(e core.InputEvent) { ctrl.query.Set(e.Value); ctrl.active.Set(0) }}
						/>
						{if ctrl.query.Get() != "" {
							<button type="reset" className="docs-search-reset" onClick={func(core.MouseEvent) { ctrl.query.Set("") }} aria-label="Reset search">
								<span className="docs-search-reset-icon" aria-hidden="true">{components.Icon("x")}</span>
							</button>
						}}
						<button type="button" className="docs-search-close" onClick={func(core.MouseEvent) { ctrl.Close() }} aria-label="Close search">Esc</button>
					</div>

					{if strings.TrimSpace(ctrl.query.Get()) == "" {
						<p className="docs-search-hint">Type to search page titles and headings.</p>
					} else if len(results) == 0 {
						<p className="docs-search-hint">No results for "{ctrl.query.Get()}".</p>
					} else {
						<ul id="docs-search-results" className="docs-search-results">
							{groupNodes...}
						</ul>
					}}
				</div>
			</div>
		)
	})
}
