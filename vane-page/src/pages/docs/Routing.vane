package docs

import (
	"github.com/filipejohansson/vane/core"

	"vane-page/src/components"
)

const basicRoutesSnippet = `func App() core.Node {
    return router.Router(
        router.Route("/", Home, router.WithTitle("Home")),
        router.Route("/about", About, router.WithTitle("About")),
        router.Route("/users/:id", UserPage, router.WithTitle("User")),
        router.Route("*",          NotFound),
    )
}`

const paramsSnippet = `func UserPage() core.Node {
    params := router.Params()
    return (<h1>User {params.Get()["id"]}</h1>)
}`

const querySnippet = `func SearchResults() core.Node {
    query := router.Query()
    return (<p>Showing results for {query.Get().Get("q")}</p>)
}`

const setQuerySnippet = `router.SetQuery(url.Values{"tab": {"billing"}})

// Clear the query string entirely:
router.SetQuery(nil)`

const layoutSnippet = `func App() core.Node {
    return router.Router(
        router.Route("/", Home, router.WithTitle("Home")),
        router.Layout("/dashboard", DashboardShell,
            router.Route("", Dashboard, router.WithTitle("Dashboard")),
            router.Route("users", UserList, router.WithTitle("Users")),
            router.Route("users/:id", UserDetail, router.WithTitle("User")),
        ),
        router.Route("*", NotFound),
    )
}

func DashboardShell() core.Node {
    return (
        <div className="shell">
            <nav className="sidebar">
                {router.Link(router.LinkProps{To: "/dashboard"}, "Overview")}
                {router.Link(router.LinkProps{To: "/dashboard/users"}, "Users")}
            </nav>
            <main>{router.Outlet()}</main>
        </div>
    )
}`

const locationSnippet = `func App() core.Node {
    router.SetLocation(&router.HashLocation{})

    return router.Router(...)
}`

const basePathSnippet = `router.SetLocation(&router.PathLocation{BasePath: "/my-app"})`

const serverConfigNginxSnippet = `location / {
  try_files $uri $uri/ /index.html;
}`

const serverConfigApacheSnippet = `Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]`

const serverConfigNetlifySnippet = `[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200`

const serverConfigVercelSnippet = `{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}`

const navigationSnippet = `router.Link(router.LinkProps{To: "/about"}, "About")

func goToAbout() {
    router.Navigate("/about")
}`

const replaceSnippet = `func requireAuth() {
    if !isLoggedIn() {
        router.Replace("/login")
    }
}`

const navigationChildrenSnippet = `// Link/ActiveLink children accept core.Node as well as string
router.Link(router.LinkProps{To: "/settings"}, icons.Gear(), "Settings")`

const pathSignalSnippet = `path := router.Path() // reactive, read-only
path.Get()             // e.g. "/dashboard/users/42"`

const activeLinkSnippet = `router.ActiveLink(router.ActiveLinkProps{
    LinkProps: router.LinkProps{
        To:        "/users",
        HTMLProps: core.HTMLProps{Class: "nav-link"},
    },
    ActiveClass: "nav-link--active",
}, "Team")`

func Routing() core.Node {
	core.Head(func() core.HeadConfig {
		title := "Routing | Vane Docs"
		description := "Routing with router.Route, router.Layout, URL and query params, Link, and ActiveLink - real paths by default, or hash-based via HashLocation."
		url := core.Window().Get("location").Get("origin").String() + "/vane/docs/routing"
		return core.HeadConfig{
			Title:         title,
			Description:   description,
			Canonical:     url,
			OGTitle:       title,
			OGDescription: description,
			OGURL:         url,
		}
	})

	items := routingTOCItems

	return (
		<div className="docs-page">
			<article className="docs-article">
				{docsHeader(
					"Data & Navigation",
					"Routing",
					"Components run once on mount, the previous route's effects are disposed on navigation. Real paths by default, or hash-based URLs via HashLocation.",
				)}

				<h2 className="docs-h2" id="basic-routes">Basic routes</h2>
				<p className="docs-p">
					<code>router.Router</code> renders the first matching entry for the current path.
					<code>router.Route</code> accepts an optional title string, which sets{" "}
					<code>document.title</code> on navigation.
				</p>
				{components.CodeBlock("App.vane", basicRoutesSnippet)}

				<h2 className="docs-h2" id="url-modes">Hash vs Path routing</h2>
				<p className="docs-p">
					The router represents the current route in the browser's URL through a{" "}
					<code>router.Location</code>. The default, <code>router.PathLocation</code>,
					represents the route as a real pathname (e.g. <code>/dashboard</code>), using the
					browser's History API to navigate without a full page reload.
				</p>
				{callout("important", "Important", "PathLocation needs the host to serve index.html for any path that isn't a real file (a \"SPA fallback\"), since a direct load or refresh of e.g. /dashboard is a real request for that path - see \"Server configuration\" below for how to set that up on common hosts.")}
				<p className="docs-p">
					Set <code>BasePath</code> when the app is deployed under a sub-path (e.g.{" "}
					<code>https://example.com/my-app/</code>). It defaults to the root and doesn't need
					to be set otherwise.
				</p>
				{components.CodeBlock("App.vane", basePathSnippet)}
				{callout("tip", "Tip", "PathLocation doesn't use the URL fragment for routing, so a plain <a href=\"#section\"> keeps working as a native same-page anchor link - something HashLocation can't offer, since it treats the whole fragment as the route.")}
				<p className="docs-p">
					Call <code>router.SetLocation</code> before the router is first used to opt into{" "}
					<code>router.HashLocation</code> instead, which stores the route after a{" "}
					<code>#</code> (e.g. <code>/#/dashboard</code>) and works on any static host with
					zero server configuration - the fragment is never sent to the server, so a page
					refresh or a shared link always resolves to the same file. Trade-off: no in-page
					anchor links (the whole fragment is the route) and no server-visible URL for
					analytics or SEO.
				</p>
				{components.CodeBlock("App.vane", locationSnippet)}

				<h2 className="docs-h2" id="server-config">Server configuration</h2>
				<p className="docs-p">
					A direct load or refresh of a non-root route (e.g. <code>/dashboard</code>) is a
					real request the host has to answer, and a plain static file server has no file at
					that path. Point it at <code>index.html</code> instead for any path it doesn't
					recognize, so Vane's own router can take over once the page loads. Skip this
					section entirely by using <code>HashLocation</code> above, which never needs it.
				</p>
				{components.PlainBlock("nginx.conf", serverConfigNginxSnippet)}
				{components.PlainBlock(".htaccess", serverConfigApacheSnippet)}
				{components.PlainBlock("netlify.toml", serverConfigNetlifySnippet)}
				{components.PlainBlock("vercel.json", serverConfigVercelSnippet)}
				{callout("important", "GitHub Pages", "GitHub Pages serves static files with no rewrite rules at all, so the fix above doesn't apply. Either switch to HashLocation, or copy the built index.html to 404.html in your deploy step - GitHub Pages serves 404.html's content for any unmatched path (keeping the real URL in the address bar), which boots the app and lets PathLocation read the actual path from there.")}

				<h2 className="docs-h2" id="url-params">URL params</h2>
				<p className="docs-p">
					<code>router.Params()</code> returns a reactive signal. Call it during component
					setup, then read <code>.Get()</code> inside JSX bindings or effects to subscribe.
				</p>
				{components.CodeBlock("UserPage.vane", paramsSnippet)}
				{callout("tip", "Tip", "The signal updates in-place when the same route pattern matches with different params - the component is not remounted.")}

				<h2 className="docs-h2" id="query-params">Query params</h2>
				<p className="docs-p">
					<code>router.Query()</code> returns the current URL's query string
					(e.g. <code>{"?tag=a&tag=b"}</code>) as a reactive signal of{" "}
					<code>url.Values</code>, the same type{" "}
					<code>net/http.Request.URL.Query()</code> returns. Call it during component
					setup, then read <code>.Get()</code> inside JSX bindings or effects to
					subscribe, same as <code>router.Params()</code>.
				</p>
				{components.CodeBlock("SearchResults.vane", querySnippet)}
				{callout("tip", "Tip", "A navigation that only changes the query string (same path) updates this signal without remounting the current route.")}
				<p className="docs-p">
					<code>router.SetQuery</code> replaces the current query string, keeping the
					current path, and pushes a new browser history entry like{" "}
					<code>router.Navigate</code>.
				</p>
				{components.CodeBlock("snippet.go", setQuerySnippet)}

				<h2 className="docs-h2" id="layouts">Layouts</h2>
				<p className="docs-p">
					<code>router.Layout</code> keeps a shell component alive across sub-navigation.
					Only the <code>router.Outlet()</code> slot updates. Child patterns are relative
					to the layout prefix.
				</p>
				{components.CodeBlock("App.vane", layoutSnippet)}
				{callout("important", "Important", "router.Outlet() returns the stable container the sub-router populates. It must be called synchronously during shell setup, not inside an Effect. Called anywhere else, including a component never passed to router.Layout as its shell, it logs a console warning and renders nothing instead of failing loudly.")}

				<h2 className="docs-h2" id="navigation">Navigation</h2>
				<p className="docs-p">
					<code>router.Link</code> renders an anchor that navigates on click.{" "}
					<code>router.Navigate</code> does the same thing programmatically.
				</p>
				{components.CodeBlock("nav.go", navigationSnippet)}
				<p className="docs-p">
					<code>router.Replace</code> does the same thing as <code>router.Navigate</code>{" "}
					but without pushing a new browser history entry, so the back button skips over it
					entirely - useful for a redirect the user shouldn't have to back out of, like
					bouncing an unauthenticated visitor from a protected route to a login page.
				</p>
				{components.CodeBlock("nav.go", replaceSnippet)}
				<p className="docs-p">
					<code>router.Link</code> and <code>router.ActiveLink</code> accept <code>core.Node</code>
					children as well as plain <code>strings</code>, so an icon component works as part of the label.
				</p>
				{components.CodeBlock("nav.go", navigationChildrenSnippet)}

				<h2 className="docs-h2" id="active-link">ActiveLink</h2>
				<p className="docs-p">
					Same as <code>Link</code>, but reactively adds a class when the current path
					matches <code>To</code>. Use it for navbars and sidebars that need to
					highlight the current route.
				</p>
				{components.CodeBlock("nav.go", activeLinkSnippet)}
				{callout("tip", "Tip", "\"/\" always uses exact match. Every other To prefix-matches by default, so /users is active on /users and /users/42 alike. Set Exact: true when To is a section index with its own sub-routes.")}

				<h2 className="docs-h2" id="path-signal">Path signal</h2>
				<p className="docs-p">
					An escape hatch for manual routing logic: <code>router.Path()</code>{" "}
					returns the current path as a reactive, read-only signal, for code
					that needs the raw path string rather than matched params.
				</p>
				{components.CodeBlock("snippet.go", pathSignalSnippet)}

				{pageNav("routing")}
			</article>
			{toc(items)}
		</div>
	)
}
