package docs

import (
	"strconv"

	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"

	"vane-page/src/components"
)

const docsSourceBase = "https://github.com/FilipeJohansson/vane/edit/master/vane-page/src/pages/docs/"

// docsHeader is the title block every doc page starts with.
func docsHeader(eyebrow, title, desc string) core.Node {
	components.RefreshIcons()
	return (
		<header className="docs-header">
			<span className="docs-eyebrow">{eyebrow}</span>
			<h1 className="docs-title">{title}</h1>
			<p className="docs-desc">{desc}</p>
		</header>
	)
}

// calloutIcon matches callout's color-by-kind convention with a glyph:
// "tip" reads as a helpful aside, "important" as a real warning.
func calloutIcon(kind string) string {
	if kind == "important" {
		return "triangle-alert"
	}
	return "lightbulb"
}

// calloutKind picks the accent color; "tip" (helpful aside) or "important"
func callout(kind, label string, children ...any) core.Node {
	return (
		<div className={"docs-callout docs-callout--" + kind}>
			<span className="docs-callout-icon" aria-hidden="true">{components.Icon(calloutIcon(kind))}</span>
			<div className="docs-callout-content">
				<span className="docs-callout-label">{label}</span>
				<p className="docs-callout-body">{core.Spread(children)...}</p>
			</div>
		</div>
	)
}

// keyFacts renders the "quick facts" panel most pages open with, right
// below docsHeader: the handful of things worth knowing before reading the
// full page, each item pre-built so callers can mix plain text and <code>
// the same way docsTable cells and callout bodies already do.
func keyFacts(items ...core.Node) core.Node {
	rows := make([]core.Node, len(items))
	for i, it := range items {
		rows[i] = keyFactItem(it)
	}
	return (
		<div className="docs-keyfacts">
			<span className="docs-keyfacts-title">
				<span className="docs-keyfacts-icon" aria-hidden="true">{components.Icon("zap")}</span>
				Key facts
			</span>
			<ul className="docs-keyfacts-list">
				{rows...}
			</ul>
		</div>
	)
}

func keyFactItem(content core.Node) core.Node {
	return (
		<li className="docs-keyfacts-item">
			<span className="docs-keyfacts-check" aria-hidden="true">{components.Icon("check")}</span>
			<span>{content}</span>
		</li>
	)
}

// tutorialCompleteToggle is the "mark this unit complete" checkbox every
// tutorial unit page ends with, backed by TutorialProgress.
func tutorialCompleteToggle(slug string) core.Node {
	done := TutorialUnitDone(slug)
	cls := "docs-tutorial-check"
	label := "Mark this unit complete"
	if done {
		cls = "docs-tutorial-check docs-tutorial-check--done"
		label = "Unit complete"
	}
	return components.IconButton(
		components.IconButtonProps{
			Class:       cls,
			AriaPressed: &done,
			OnClick: func(core.MouseEvent) {
				ToggleTutorialUnit(slug)
				// The checkmark glyph (and Unit 5's congrats banner icon)
				// only enter the DOM once this reactive toggle flips true,
				// well after any mount-time RefreshIcons call already ran.
				core.NextTick(func() { components.RefreshIcons() })
			},
		},
		tutorialCheckBox(done), label,
	)
}

func tutorialCheckBox(done bool) core.Node {
	return (
		<span className="docs-tutorial-check-box" aria-hidden="true">
			{if done {
				<>{components.Icon("check")}</>
			}}
		</span>
	)
}

// pipeline renders a compact numbered flow, e.g. the .vane -> app.wasm build
// steps in Concepts. Kept as real styled DOM rather than a "diagram" pushed
// through CodeBlock's Go syntax highlighter, since plain step text isn't Go
// and would render with no highlighting at all.
func pipeline(steps ...string) core.Node {
	nodes := make([]core.Node, len(steps))
	for i, s := range steps {
		nodes[i] = pipelineStep(i+1, s)
	}
	return (
		<div className="docs-pipeline">
			{nodes...}
		</div>
	)
}

func pipelineStep(n int, label string) core.Node {
	return (
		<div className="docs-pipeline-step">
			<span className="docs-pipeline-num">{strconv.Itoa(n)}</span>
			<span>{label}</span>
		</div>
	)
}

// docsTable renders a titled reference table (border, header row, zebra-free
// body), same box treatment as callout/code-block/pipeline. headers are
// plain labels; each row is a fixed-width slice of pre-built cell nodes, one
// per column. Build a cell with code(s) for a single <code> token, or
// core.Fragment(...) to mix text and code within one cell.
func docsTable(headers []string, rows [][]core.Node) core.Node {
	headerCells := make([]core.Node, len(headers))
	for i, h := range headers {
		headerCells[i] = tableHeaderCell(h)
	}
	rowNodes := make([]core.Node, len(rows))
	for i, cells := range rows {
		tds := make([]core.Node, len(cells))
		for j, c := range cells {
			tds[j] = tableDataCell(c)
		}
		rowNodes[i] = tableRow(tds)
	}
	return (
		<div className="docs-table-wrap">
			<table className="docs-table">
				<thead>{tableRow(headerCells)}</thead>
				<tbody>{rowNodes...}</tbody>
			</table>
		</div>
	)
}

func tableHeaderCell(label string) core.Node {
	return (<th>{label}</th>)
}

func tableDataCell(content core.Node) core.Node {
	return (<td>{content}</td>)
}

func tableRow(cells []core.Node) core.Node {
	return (<tr>{cells...}</tr>)
}

// code renders a single inline <code> token, for use as a docsTable cell.
func code(s string) core.Node {
	return (<code>{s}</code>)
}

// scrollSpyOffset is how far (in px) a heading's top can be below the
// viewport top and still count as "current": clears the sticky site nav
// (3.5rem) plus the reading-progress bar, with a little breathing room.
const scrollSpyOffset = 90.0

// setupScrollSpy watches window scroll and keeps active set to the id of
// the lowest heading that's scrolled past scrollSpyOffset. Called once from
// a ref callback (see toc below), not from a reactive {expr}, so it isn't
// re-registered every time active itself changes.
func setupScrollSpy(items []tocItem, active *core.Signal[string]) {
	update := func() {
		current := ""
		for _, it := range items {
			el, ok := core.GetElementByID(it.ID)
			if !ok {
				continue
			}
			if core.BoundingRect(el).Top <= scrollSpyOffset {
				current = it.ID
			}
		}
		if current == "" && len(items) > 0 {
			current = items[0].ID
		}
		// The last heading's own section is often too short to ever push its
		// top past scrollSpyOffset (nothing left below it to scroll through),
		// so the loop above can never select it. Once the page is scrolled to
		// its true bottom, force the last item active regardless.
		scrollY := core.ScrollY()
		_, innerHeight := core.Viewport()
		scrollHeight, _ := core.DocumentHeight()
		if len(items) > 0 && scrollY+innerHeight >= scrollHeight-2 {
			current = items[len(items)-1].ID
		}
		if active.Get() != current {
			active.Set(current)
		}
	}

	// Headings aren't attached to the document yet at ref-callback time (see
	// refs-and-dom.md), so getBoundingClientRect would see stale/zeroed
	// layout on the very first call. Defer it a tick; the scroll listener
	// itself only ever fires later, once layout is live, so it doesn't need
	// the same deferral.
	core.NextTick(update)

	core.OnWindowEvent("scroll", func(core.Event) { update() }, core.ListenerOpts{Passive: true})
}

// tocScrollTopThreshold is how far down the page (in px) the reader has to
// scroll before the "Scroll to top" action appears.
const tocScrollTopThreshold = 400.0

func setupTocScrollTop(show *core.Signal[bool]) {
	update := func() {
		next := core.ScrollY() > tocScrollTopThreshold
		if next == show.Get() {
			return
		}
		show.Set(next)
		if next {
			// A single mount-time RefreshIcons call (see toc below) isn't
			// reliably late enough for this icon to have settled into the
			// DOM yet. A real scroll event is - give it another shot here,
			// the first time the button actually becomes visible.
			components.RefreshIcons()
		}
	}
	core.NextTick(update)
	core.OnWindowEvent("scroll", func(core.Event) { update() }, core.ListenerOpts{Passive: true})
}

func scrollTopClass(visible bool) string {
	if visible {
		return "docs-scrolltop docs-scrolltop--visible"
	}
	return "docs-scrolltop"
}

func tocScrollTopIcon() core.Node {
	return <span className="docs-toc-action-icon" aria-hidden="true">{components.Icon("arrow-up")}</span>
}

func tocLink(it tocItem, active *core.Signal[string]) core.Node {
	return (
		<li>
			<a
				href={"#" + it.ID}
				className={func() string {
					if active.Get() == it.ID {
						return "docs-toc-link docs-toc-link--active"
					}
					return "docs-toc-link"
				}()}
			>
				{it.Label}
			</a>
		</li>
	)
}

func toc(items []tocItem, slug string) core.Node {
	active := core.NewSignal("")
	showScrollTop := core.NewSignal(false)
	links := make([]core.Node, len(items))
	for i, it := range items {
		links[i] = tocLink(it, active)
	}
	t, _ := TopicBySlug(slug)
	return (
		<div className="docs-toc-col">
			<aside className="docs-toc" ref={func(el core.Node) { setupScrollSpy(items, active); setupTocScrollTop(showScrollTop) }}>
				<span className="docs-toc-title">On this page</span>
				<ul className="docs-toc-list">
					{links...}
				</ul>
				<div className="docs-toc-actions">
					<a className="docs-toc-action" href={docsSourceBase + t.File} target="_blank" rel="noopener noreferrer">
						Edit this page on GitHub
						<span className="docs-toc-action-icon" aria-hidden="true">{components.Icon("external-link")}</span>
					</a>
				</div>
			</aside>
			{components.IconButton(
				components.IconButtonProps{Class: scrollTopClass(showScrollTop.Get()), OnClick: func(core.MouseEvent) { core.ScrollTo(0, true) }},
				"Scroll to top", tocScrollTopIcon(),
			)}
		</div>
	)
}

// navCard is one side of the prev/next footer nav. dir is "prev" or "next".
func navCard(dir, slug, title string) core.Node {
	to := "/docs"
	if slug != "" {
		to = "/docs/" + slug
	}
	label := "Next"
	if dir == "prev" {
		label = "Previous"
	}
	return router.Link(router.LinkProps{
		To:        to,
		HTMLProps: core.HTMLProps{Class: "docs-pagenav-card docs-pagenav-card--" + dir},
	}, navCardBody(dir, label, title))
}

func navCardBody(dir, label, title string) core.Node {
	arrow := components.Icon("arrow-right")
	if dir == "prev" {
		arrow = components.Icon("arrow-left")
	}
	return (
		<>
			<span className="docs-pagenav-label">
				{if dir == "prev" {
					<span className="docs-pagenav-arrow" aria-hidden="true">{arrow}</span>
				} else {
					<span />
				}}
				{label}
				{if dir == "next" {
					<span className="docs-pagenav-arrow" aria-hidden="true">{arrow}</span>
				} else {
					<span />
				}}
			</span>
			<span className="docs-pagenav-title">{title}</span>
		</>
	)
}

// pageNav renders the bottom prev/next row from slug's neighbors in the
// manifest. Either side is omitted when slug is first/last (or unlisted,
// e.g. the overview index itself, whose slug is "").
func pageNav(slug string) core.Node {
	components.RefreshIcons()
	prev, next, hasPrev, hasNext := PrevNext(slug)
	cls := "docs-pagenav"
	if !hasPrev || !hasNext {
		cls = "docs-pagenav docs-pagenav--single"
	}
	return (
		<div className={cls}>
			{if hasPrev {
				<>{navCard("prev", prev.Slug, prev.Title)}</>
			}}
			{if hasNext {
				<>{navCard("next", next.Slug, next.Title)}</>
			}}
		</div>
	)
}
