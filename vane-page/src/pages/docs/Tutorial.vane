package docs

import (
	"fmt"

	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"

	"vane-page/src/components"
	"vane-page/src/seo"
)

// tutorialDocLink is a same-site cross-reference from tutorial prose to
// another docs page, styled like the inline links other guides use (e.g.
// Concepts' link to Lifecycle). Shared by every tutorial-unit file in this
// package.
func tutorialDocLink(slug, label string) core.Node {
	return router.Link(router.LinkProps{
		To:        "/docs/" + slug,
		HTMLProps: core.HTMLProps{Class: "docs-inline-link"},
	}, label)
}

// tutorialUnits lists the five hands-on units in build order, for the
// landing page's unit grid below. Each is its own route/page (see
// TutorialUnit1..5 in TutorialUnit*.vane) so pageNav's prev/next chains
// through them via the matching manifest.go entries, same mechanism as
// every other docs sequence.
var tutorialUnits = []struct {
	step, title, desc, slug string
}{
	{"1", "Scaffold the Project", "Create the app, confirm the dev server works, add the tutorial's stylesheet.", "tutorial-1-scaffold"},
	{"2", "Model the Data & Render the List", "A signal-backed Todo store and a reactive, keyed list.", "tutorial-2-data-model"},
	{"3", "Add New Todos", "A controlled form input and a store function that appends to the list.", "tutorial-3-add-todos"},
	{"4", "Toggle & Remove", "A checkbox and a remove button, each driving the store by item ID.", "tutorial-4-toggle-remove"},
	{"5", "Filter by Route", "Three routes, one page - the URL decides what's visible.", "tutorial-5-filter-routes"},
}

// tutorialUnitCard is the landing page's own card, not the shared
// quickstartCard Overview.vane uses - it needs a done-checkmark badge
// quickstartCard has no reason to carry.
func tutorialUnitCard(step, title, desc, slug string) core.Node {
	done := TutorialUnitDone(slug)
	cls := "docs-quickstart-card docs-tutorial-unit-card"
	if done {
		cls = "docs-quickstart-card docs-tutorial-unit-card docs-tutorial-unit-card--done"
	}
	return router.Link(router.LinkProps{
		To:        "/docs/" + slug,
		HTMLProps: core.HTMLProps{Class: cls},
	}, tutorialUnitCardBody(step, title, desc, done))
}

func tutorialUnitCardBody(step, title, desc string, done bool) core.Node {
	return (
		<>
			<div className="docs-tutorial-unit-top">
				<span className="docs-quickstart-step">{step}</span>
				{if done {
					<span className="docs-tutorial-unit-done" aria-label="Complete">{components.Icon("check-circle")}</span>
				}}
			</div>
			<h3 className="docs-quickstart-title">{title}</h3>
			<p className="docs-quickstart-desc">{desc}</p>
		</>
	)
}

func tutorialUnitCards() core.Node {
	cards := make([]core.Node, len(tutorialUnits))
	for i, u := range tutorialUnits {
		cards[i] = tutorialUnitCard(u.step, u.title, u.desc, u.slug)
	}
	return core.Fragment(cards...)
}

// tutorialProgressSummary is the "N of 5 complete" bar atop the unit grid.
func tutorialProgressSummary() core.Node {
	n := TutorialCompletedCount()
	total := len(TutorialUnitSlugs)
	pct := 0.0
	if total > 0 {
		pct = float64(n) / float64(total) * 100
	}
	label := fmt.Sprintf("%d of %d units complete", n, total)
	if n == total {
		label = "All units complete — nice work!"
	}
	return (
		<div className="docs-tutorial-progress">
			<div className="docs-tutorial-progress-row">
				<span className="docs-tutorial-progress-label">{label}</span>
				<span className="docs-tutorial-progress-pct">{fmt.Sprintf("%.0f%%", pct)}</span>
			</div>
			<div className="docs-tutorial-progress-track">
				<div className="docs-tutorial-progress-fill" style={core.Style{Width: fmt.Sprintf("%.1f%%", pct)}} />
			</div>
		</div>
	)
}

func Tutorial() core.Node {
	core.Head(func() core.HeadConfig {
		title := "Tutorial: Build a Todo List | Vane Docs"
		description := "A step-by-step tutorial building a real Vane app: signals, events, a reactive keyed list, and routing."
		url := seo.CanonicalURL("/docs/tutorial")
		return core.HeadConfig{
			Title:         title,
			Description:   description,
			Canonical:     url,
			OGTitle:       title,
			OGDescription: description,
			OGURL:         url,
		}
	})

	items := tutorialTOCItems

	return (
		<div className="docs-page">
			<article className="docs-article">
				{docsHeader(
					"Tutorial",
					"Build a Todo List",
					"A hands-on walkthrough of a real Vane app, built up one unit at a time: a signal-backed data model, a reactive keyed list, form events, and routing.",
				)}

				<h2 className="docs-h2" id="prerequisites">Before you begin</h2>
				<p className="docs-p">You'll need:</p>
				<ul className="docs-list">
					<li>Go 1.25+ and the <code>vane</code> CLI installed — see {tutorialDocLink("installation", "Installation")} if you haven't yet.</li>
					<li>A terminal and a text editor.</li>
					<li>A current desktop browser (Chrome, Edge, Firefox, or Safari).</li>
				</ul>
				<p className="docs-p">
					This tutorial assumes you've read Concepts, or are comfortable
					learning Vane's mental model as you go: no virtual DOM, components
					are plain Go functions, and every <code>{"{expr}"}</code> binding
					is its own fine-grained reactive <code>Effect</code>.
				</p>

				<h2 className="docs-h2" id="units">What you'll build</h2>
				<p className="docs-p">
					A todo list with add, toggle, remove, and route-based filtering
					(All / Active / Completed) — every core building block, one small
					piece at a time. Each unit is its own page, small enough to finish
					in one sitting; do them in order, each builds directly on the last.
				</p>
				{tutorialProgressSummary()}
				<div className="docs-quickstart-grid">
					{tutorialUnitCards()}
				</div>

				{pageNav("tutorial")}
			</article>
			{toc(items, "tutorial")}
		</div>
	)
}
