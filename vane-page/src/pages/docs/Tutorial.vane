vane init github.com/you/todo-app
vane run`

const tutorialStyleSnippet = `.todo-form {
  display: flex;
  gap: 0.5rem;
}

.todo-form .input {
  flex: 1;
  max-width: none;
}

.todo-add {
  background: var(--primary);
  color: var(--bg);
  border: none;
  border-radius: 8px;
  padding: 0.5rem 1rem;
