package pages

import (
	"vane-page/src/components"
	"github.com/filipejohansson/vane/core"
)

func Home() core.Node {
	core.Head(func() core.HeadConfig {
		title := "Vane — Frontend development, the Go way."
		description := "A Go-native frontend framework with fine-grained reactivity, direct DOM updates, and JSX-like syntax."
		url := core.Window().Get("location").Get("origin").String() + "/vane"
		return core.HeadConfig{
			Title:         title,
			Description:   description,
			Canonical:     url,
			OGTitle:       title,
			OGDescription: description,
			OGURL:         url,
		}
	})

	return (
		<>
			{components.Hero()}
			{components.FeatureTabs()}
			{components.Features()}
			{components.DocsCards()}
			{components.CommunityCTA()}
		</>
	)
}
