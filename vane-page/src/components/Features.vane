	)
}

const vscodeExtSVG = `<svg viewBox="1.4 1 24 24" xmlns="http://www.w3.org/2000/svg" fill="none"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M16.75 6H20a1 1 0 0 1 1 1v3.25a.75.75 0 0 1-.75.75H20a2 2 0 1 0 0 4h.25a.75.75 0 0 1 .75.75V20a1 1 0 0 1-1 1h-3.25a.75.75 0 0 1-.75-.75V20a2 2 0 1 0-4 0v.25a.75.75 0 0 1-.75.75H7a1 1 0 0 1-1-1v-4.25a.75.75 0 0 0-.75-.75H5a2 2 0 1 1 0-4h.25a.75.75 0 0 0 .75-.75V7a1 1 0 0 1 1-1h4.25a.75.75 0 0 0 .75-.75V5a2 2 0 1 1 4 0v.25c0 .414.336.75.75.75z"></path></svg>`

func vscodeVisual() core.Node {
	return (
		<div className="feature-visual feature-visual--vscode">
			<span className="vscode-ext-icon" aria-hidden="true">{core.DangerousInnerHTML(vscodeExtSVG)}</span>
			<span className="vscode-vane-icon" aria-hidden="true">{core.DangerousInnerHTML(vaneLogoSVG)}</span>
		</div>
	)
}

type signalOrbitItem struct {
	label  string
	before string
	after  string
	track  int // 1-3, which orbit radius - see signal-ring--track-N in CSS
	phase  int // 0-2, this item's evenly-spaced starting position among its track's other items - see signal-ring--phase-N in CSS
}

var signalOrbitItems = []signalOrbitItem{
	{"Cart:", "2", "3", 1, 0},
	{"Total:", "$42", "$58", 1, 1},
	{"Theme:", "dark", "light", 2, 0},
	{"Online:", "128", "142", 2, 1},
	{"Users:", "4", "6", 2, 2},
	{"Tab:", "Home", "Docs", 3, 0},
	{"Likes:", "12", "15", 3, 1},
	{"Views:", "89", "97", 3, 2},
}

func signalOrbit(it signalOrbitItem) core.Node {
	cls := fmt.Sprintf("signal-ring signal-ring--track-%d signal-ring--phase-%d", it.track, it.phase)
	return (
		<div className={cls}>
			<div className="signal-chip-wrap">
				<span className="signal-chip">
					<span className="signal-chip-label">{it.label}</span>
					<span className="signal-chip-value-slot">
						<span className="signal-chip-value signal-chip-value--before">{it.before}</span>
						<span className="signal-chip-value signal-chip-value--after">{it.after}</span>
					</span>
				</span>
			</div>
		</div>
	)
}

func signalTrack(n int) core.Node {
	return <span className={fmt.Sprintf("signal-track signal-track--%d", n)} aria-hidden="true" />
}

func signalsVisual() core.Node {
	orbits := make([]core.Node, len(signalOrbitItems))
	for i, it := range signalOrbitItems {
		orbits[i] = signalOrbit(it)
	}
	return (
		<div className="feature-visual feature-visual--signals">
			<div className="signal-cloud">
				{signalTrack(1)}
				{signalTrack(2)}
				{signalTrack(3)}
				{orbits...}
				<span className="signal-button" aria-hidden="true">{Icon("zap")}</span>
			</div>
		</div>
	)
}

const vaneSyntaxSnippet = `func Counter() core.Node {
    count := core.NewSignal(0)

    return (
        <button onClick={func(core.MouseEvent) {
            count.Set(count.Get() + 1)
        }}>
            {count.Get()}
        </button>
    )
}`

func syntaxVisual() core.Node {
	return (
		<div className="feature-visual feature-visual--syntax">
			<div className="syntax-editor">
				<div className="syntax-mini-bar">
					<span className="code-block-dot" />
					<span className="code-block-dot" />
					<span className="code-block-dot" />
				</div>
				<div className="syntax-editor-main">
					<div className="syntax-sidebar">
						<span className="syntax-sidebar-icon">{Icon("files")}</span>
						<span className="syntax-sidebar-icon">{Icon("search")}</span>
						<span className="syntax-sidebar-icon">{Icon("git-fork")}</span>
						<span className="syntax-sidebar-icon">{Icon("play")}</span>
						<span className="syntax-sidebar-icon syntax-sidebar-icon--settings">{Icon("settings")}</span>
					</div>
					<pre className="syntax-mini-code"><code>{core.DangerousInnerHTML(HighlightGoHTML(vaneSyntaxSnippet))}</code></pre>
				</div>
			</div>
		</div>
	)
}

