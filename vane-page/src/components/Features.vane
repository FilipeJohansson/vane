const storeSVG = `<svg viewBox="0 0 800 120" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle class="store-dot store-dot--nav" r="4" cx="400" cy="20" />
<circle class="store-dot store-dot--cart" r="4" cx="400" cy="20" />
<circle class="store-dot store-dot--profile" r="4" cx="400" cy="20" />
</svg>`

func storeVisual() core.Node {
	return (
		<div className="feature-visual feature-visual--store">
			<span className="store-diagram" aria-hidden="true">{core.DangerousInnerHTML(storeSVG)}</span>
			<span className="store-pill">store.User</span>
			<span className="store-consumer store-consumer--nav">Nav</span>
			<span className="store-consumer store-consumer--cart">Cart</span>
			<span className="store-consumer store-consumer--profile">Profile</span>
		</div>
	)
}

type shippedFeature struct {
	visual func() core.Node
	title  string
	desc   string
	// size picks a feature-card--* bento variant: "wide" (2 cols), "tall"
	// (2 rows), "banner" (2 cols, visual beside text instead of above it),
	// "reverse" (visual below text), or "" for a plain 1x1 card.
	size string
	slug string
}

var shippedFeatures = []shippedFeature{
	{routerVisual, "Router & Layouts", "Nested routes, layouts, URL params, hash or path-based navigation.", "wide", "routing"},
	{portalsVisual, "Portals", "Render into any DOM node outside the component tree - modals, toasts.", "tall", "portal"},
	{a11yVisual, "Accessibility", "Focus management, aria-* helpers, and live regions built in.", "reverse", "accessibility"},
	{headVisual, "Head Management", "Reactive title, meta tags, and canonical URLs per route.", "banner", "head"},
	{errorBoundaryVisual, "Error Boundaries", "Catch render and effect errors before they take down the page.", "", "error-boundary"},
	{hotReloadVisual, "Hot Reload", "vane run watches your source and updates the browser automatically.", "reverse", "develop-and-build"},
	{vscodeVisual, "VS Code Extension", "Syntax highlighting, diagnostics, hover, go-to-definition for .vane.", "reverse", "vscode-extension"},
	{storeVisual, "Global Store", "Package-level signals for shared state.", "wide", "store"},
	{syntaxVisual, "Vane Syntax", "The HTML-like syntax inside .vane files, compiled by Vane's own parser.", "", "vane-syntax"},
	{componentsVisual, "Components", "Functions, children, the controller pattern.", "tall", "components"},
	{signalsVisual, "Signals & Reactivity", "Effect, OnDispose, ComputedOf, Untrack.", "tall", "signals"},
}

func shippedFeatureText(f shippedFeature) core.Node {
	return (
		<div className="feature-text">
			<h3 className="feature-title">{f.title}</h3>
			<p className="feature-desc">{f.desc}</p>
		</div>
	)
}

func shippedFeatureCard(f shippedFeature, id string) core.Node {
	cls := "feature-card"
	if f.size != "" {
		cls = "feature-card feature-card--" + f.size
	}
	to := "/docs/" + f.slug
	if f.slug == "" {
		to = "/docs"
	}
	return router.Link(router.LinkProps{
		To:        to,
		HTMLProps: core.HTMLProps{Class: cls, ID: id},
	}, f.visual(), shippedFeatureText(f))
}

func Features() core.Node {
	core.Effect(func() func() {
		RefreshIcons()
		return nil
	})

	cards := make([]core.Node, len(shippedFeatures))
	ids := make([]string, len(shippedFeatures)+1)
	for i, f := range shippedFeatures {
		ids[i] = fmt.Sprintf("feature-card-%d", i)
		cards[i] = shippedFeatureCard(f, ids[i])
	}
	ids[len(shippedFeatures)] = "feature-card-docs"
	SetupScrollActivate(ids)

	return (
		<section className="section" id="features">
			<div className="section-header">
				<span className="eyebrow">
					<span className="eyebrow-dot" aria-hidden="true" />
					Batteries included
				</span>
				<h2 className="section-title">Everything you need for a real app</h2>
			</div>
			<div className="feature-grid">
				{cards...}
				{router.Link(router.LinkProps{
					To:        "/docs",
					HTMLProps: core.HTMLProps{Class: "feature-card feature-card--docs-cta", ID: "feature-card-docs"},
				}, docsFeatureVisual())}
			</div>
		</section>
	)
}
