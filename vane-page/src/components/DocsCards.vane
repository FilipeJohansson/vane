package components

import (
	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"
)

type learnPanelInfo struct {
	icon  string
	title string
	desc  string
	cta   string
	slug  string
}

var learnPanelsList = []learnPanelInfo{
	{"graduation-cap", "New to Vane?", "Try our tutorial lessons, step by step.", "Start tutorial", "tutorial"},
	{"compass", "Want to know more?", "Go through our guides and learn Vane's core concepts.", "Vane concepts", "concepts"},
	{"library", "Already building?", "Look up any signal, effect, or DOM helper by name.", "API reference", "api-reference"},
}

func learnPanelInner(p learnPanelInfo) core.Node {
	return (
		<div className="learn-panel-inner">
			<span className="learn-panel-flare" aria-hidden="true" />
			<span className="learn-panel-ghost" aria-hidden="true">{Icon(p.icon)}</span>
			<span className="learn-panel-cta">
				{p.cta}
				<span className="learn-panel-arrow" aria-hidden="true">{Icon("arrow-right")}</span>
			</span>
			<h3 className="learn-panel-title">{p.title}</h3>
			<div className="learn-panel-reveal">
				<p className="learn-panel-desc">{p.desc}</p>
			</div>
		</div>
	)
}

func learnPanel(p learnPanelInfo) core.Node {
	return router.Link(router.LinkProps{
		To:        "/docs/" + p.slug,
		HTMLProps: core.HTMLProps{Class: "learn-panel"},
	}, learnPanelInner(p))
}

func DocsCards() core.Node {
	core.Effect(func() func() {
		RefreshIcons()
		return nil
	})

	panels := make([]core.Node, len(learnPanelsList))
	for i, p := range learnPanelsList {
		panels[i] = learnPanel(p)
	}

	return (
		<section className="section" id="learn-more">
			<div className="section-header">
				<h2 className="section-title">Want to learn more about Vane?</h2>
			</div>
			<div className="learn-accordion">
				{panels...}
			</div>
		</section>
	)
}
