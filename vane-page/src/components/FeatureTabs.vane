package components

import (
	"fmt"
	"io"
	"math/rand"
	"net/http"
	"strings"
	"time"

	"github.com/filipejohansson/vane/core"
)

const componentSnippet = `func Greeting() core.Node {
    name := core.NewSignal("")

    return (
        <div>
            <input
                value={name.Get()}
                onInput={func(e core.InputEvent) {
                    name.Set(e.Value)
                }}
            />
            {if name.Get() != "" {
                <p>Hello, {name.Get()}!</p>
            }}
        </div>
    )
}`

const signalsSnippet = `func Counter() core.Node {
    count := core.NewSignal(0)

    return (
        <div>
            <button onClick={func(core.MouseEvent) {
                count.Set(count.Get() + 1)
            }}>+1</button>
            <p>Count: {count.Get()}</p>
        </div>
    )
}`

const dataFetchingSnippet = `func Quote() core.Node {
    quote := core.NewSignal("")

    go func() {
        resp, _ := http.Get("https://api.github.com/zen")
        defer resp.Body.Close()

        body, _ := io.ReadAll(resp.Body)
        quote.Set(string(body))
    }()

    return (<p>{quote.Get()}</p>)
}`

const routerSnippet = `func App() core.Node {
    return router.Router(
        router.Route("/", Home, router.WithTitle("Home")),
        router.Route(
            "/users/:id",
            UserPage,
            router.WithTitle("User")
	),
        router.Route("*", NotFound),
    )
}`

type featureTabInfo struct {
	id    string
	label string
}

var featureTabsList = []featureTabInfo{
	{"signals", "Signals"},
	{"components", "Components"},
	{"data", "Data Fetching"},
	{"router", "Router"},
}

func featureTabButton(active *core.Signal[string], t featureTabInfo) core.Node {
	cls := "feature-tab"
	selected := active.Get() == t.id
	if selected {
		cls = "feature-tab feature-tab--active"
	}
	return IconButton(
		IconButtonProps{Key: t.id, Class: cls, Role: "tab", AriaSelected: &selected, OnClick: func(core.MouseEvent) { active.Set(t.id) }},
		t.label,
	)
}

func featurePanelHeader(title, desc, docsSlug string) core.Node {
	return (
		<div className="feature-panel-header">
			<h3 className="feature-panel-title">{title}</h3>
			<p className="feature-panel-desc">{desc}</p>
			{Button(ButtonProps{Variant: "ghost", Class: "feature-panel-link", To: "/docs/" + docsSlug}, "Learn more")}
		</div>
	)
}

func previewFrameBar(label string) core.Node {
	return (
		<div className="preview-frame-bar">
			<span className="code-block-dot" />
			<span className="code-block-dot" />
			<span className="code-block-dot" />
			<span className="preview-frame-label">{label}</span>
		</div>
	)
}

// Used on every tab for consistency - routerPanel's own nav buttons read
// as the page's in-app controls sitting below this site-level header, not
// a duplicate of it.
func demoPageHeader() core.Node {
	return (
		<div className="demo-page-header">
			<span className="demo-page-header-dot" />
			<span className="demo-page-header-nav" />
			<span className="demo-page-header-nav" />
		</div>
	)
}

// signalsPanel proves fine-grained reactivity instead of describing it:
// mountID is computed once, when the panel mounts. If the whole panel ever
// re-rendered, it would change. It never does, because count is its own
// signal-driven binding and nothing else is.
func signalsPanel() core.Node {
	count := core.NewSignal(0)
	pulsing := core.NewSignal(false)
	mountID := fmt.Sprintf("%04d", rand.Intn(10000))

	onClick := func() {
		count.Set(count.Get() + 1)
		pulsing.Set(true)
		go func() {
			time.Sleep(500 * time.Millisecond)
			pulsing.Set(false)
		}()
	}

	return (
		<div className="feature-panel-split">
			{CodePanel("Counter.vane", signalsSnippet)}
			<div className="feature-panel-preview-col">
				{featurePanelHeader(
					"Signals: Fine-Grained Reactivity",
					"Click the button below. Only count updates; the mount id stays the same because this pane never re-renders as a whole.",
					"signals",
				)}
				<div className="preview-frame">
					{previewFrameBar("localhost:8080")}
					<div className="preview-frame-body">
						{demoPageHeader()}
						<div className="preview-frame-stage">
							<div className="demo-visual">
								<div className="demo-node demo-node--static">
									<span className="demo-node-label">mount id</span>
									<span className="demo-node-value">#{mountID}</span>
								</div>
								<div className={func() string {
									if pulsing.Get() {
										return "demo-wire demo-wire--pulse"
									}
									return "demo-wire"
								}()} />
								<div className="demo-node demo-node--live">
									<span className="demo-node-label">count</span>
									<span className="demo-node-value demo-node-value--live">{count.Get()}</span>
								</div>
							</div>
							<div className="demo-cta">
								{Button(ButtonProps{Variant: "primary", OnClick: func(core.MouseEvent) { onClick() }}, "Trigger update")}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	)
}

func componentsPanel() core.Node {
	name := core.NewSignal("")

	return (
		<div className="feature-panel-split">
			{CodePanel("Greeting.vane", componentSnippet)}
			<div className="feature-panel-preview-col">
				{featurePanelHeader(
					"Components: Plain Go Functions",
					"A component is a Go function returning core.Node. Type your name below, the greeting updates reactively.",
					"components",
				)}
				<div className="preview-frame">
					{previewFrameBar("localhost:8080")}
					<div className="preview-frame-body">
						{demoPageHeader()}
						<div className="preview-frame-stage">
							<div className="demo-form">
								<label className="demo-label" htmlFor="name-input">Your name</label>
								<input
									id="name-input"
									className="input"
									placeholder="Type here"
									value={name.Get()}
									onInput={func(e core.InputEvent) { name.Set(e.Value) }}
								/>
								{if name.Get() != "" {
									<p className="greeting">Hello, {name.Get()}!</p>
								}}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	)
}

// dataFetchingPanel calls a real endpoint with a goroutine and net/http
// directly, no fetch wrapper, no async library. api.github.com/zen returns
// a different line each time, so re-fetching visibly proves it's a live
// network call, not a canned value.
func dataFetchingPanel() core.Node {
	status := core.NewSignal("idle")
	quote := core.NewSignal("")

	fetchQuote := func() {
		status.Set("loading")
		go func() {
			resp, err := http.Get("https://api.github.com/zen")
			if err != nil {
				status.Set("error")
				return
			}
			defer resp.Body.Close()

			if resp.StatusCode != http.StatusOK {
				status.Set("error")
				return
			}

			body, err := io.ReadAll(resp.Body)
			if err != nil {
				status.Set("error")
				return
			}
			quote.Set(strings.TrimSpace(string(body)))
			status.Set("done")
		}()
	}
	fetchQuote()

	quoteText := func() string {
		switch status.Get() {
		case "error":
			return "Couldn't reach the API, try again."
		case "done":
			return "“" + quote.Get() + "”"
		default:
			return ""
		}
	}

	return (
		<div className="feature-panel-split">
			{CodePanel("Quote.vane", dataFetchingSnippet)}
			<div className="feature-panel-preview-col">
				{featurePanelHeader(
					"Data Fetching: Real Go, net/http",
					"No fetch wrapper, no async library. A goroutine calls net/http directly from WASM and sets a signal when it resolves. The request below is live, to GitHub's Zen API.",
					"data-fetching",
				)}
				<div className="preview-frame">
					{previewFrameBar("api.github.com/zen")}
					<div className="preview-frame-body">
						{demoPageHeader()}
						<div className="preview-frame-stage">
							<div className="demo-quote-card">
								{if status.Get() == "loading" {
									<div className="spinner" role="status" aria-label="Fetching" />
								} else {
									<p className="demo-quote">{quoteText()}</p>
								}}
							</div>
							<div className="demo-cta">
								{Button(ButtonProps{Variant: "primary", OnClick: func(core.MouseEvent) { fetchQuote() }}, "Fetch another")}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	)
}

type routerStop struct {
	path  string
	label string
}

var routerStops = []routerStop{
	{"/", "Home"},
	{"/users/3", "User"},
	{"/nope", "404"},
}

func routerStopContent(path string) string {
	switch path {
	case "/":
		return "Home page"
	case "/users/3":
		return "User #3"
	default:
		return "404: page not found"
	}
}

func routerStopButton(path *core.Signal[string], s routerStop) core.Node {
	cls := "router-demo-stop"
	if path.Get() == s.path {
		cls = "router-demo-stop router-demo-stop--active"
	}
	return IconButton(IconButtonProps{Key: s.path, Class: cls, OnClick: func(core.MouseEvent) { path.Set(s.path) }}, s.label)
}

// path is a local signal, not the real router - mocked so the demo stays
// self-contained inside the tab instead of touching the page's own route.
func routerPanel() core.Node {
	path := core.NewSignal("/")

	stopButtons := func() []core.Node {
		nodes := make([]core.Node, len(routerStops))
		for i, s := range routerStops {
			nodes[i] = routerStopButton(path, s)
		}
		return nodes
	}

	return (
		<div className="feature-panel-split">
			{CodePanel("App.vane", routerSnippet)}
			<div className="feature-panel-preview-col">
				{featurePanelHeader(
					"Router: Layouts, Params, Nested Routes",
					"Hash-based routing with layouts, URL params, and nested routes. Components run once on mount, the previous route's effects are disposed on navigation.",
					"routing",
				)}
				<div className="preview-frame">
					{previewFrameBar("localhost:8080" + path.Get())}
					<div className="preview-frame-body">
						{demoPageHeader()}
						<div className="preview-frame-stage">
							<div className="router-demo">
								<div className="router-demo-nav">
									{stopButtons()...}
								</div>
								<div className="router-demo-content">{routerStopContent(path.Get())}</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	)
}

func FeatureTabs() core.Node {
	active := core.NewSignal("signals")

	tabButtons := func() []core.Node {
		nodes := make([]core.Node, len(featureTabsList))
		for i, t := range featureTabsList {
			nodes[i] = featureTabButton(active, t)
		}
		return nodes
	}

	return (
		<section className="section" id="demo">
			<div className="section-header">
				<span className="eyebrow">
					<span className="eyebrow-dot" aria-hidden="true" />
					Interactive
				</span>
				<h2 className="section-title">Try it live.</h2>
			</div>
			<div className="feature-tabs">
				<div className="feature-tab-list" role="tablist">
					{tabButtons()...}
				</div>
				{switch active.Get() {
				case "components":
					<>{componentsPanel()}</>
				case "data":
					<>{dataFetchingPanel()}</>
				case "router":
					<>{routerPanel()}</>
				default:
					<>{signalsPanel()}</>
				}}
			</div>
		</section>
	)
}
