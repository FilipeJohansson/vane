package components

import (
	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"
)

func Hero() core.Node {
	installCmd := "go install github.com/filipejohansson/vane@latest"

	return (
		<section className="hero" id="hero">
			<div className="hero-inner">
				<div className="hero-copy">
					<span className="eyebrow">
						<span className="eyebrow-dot" aria-hidden="true" />
						Go + WebAssembly
					</span>
					<h1 className="hero-title">
						Write UI in <span className="text-gradient">Go</span>.<br />
						Compile straight to the DOM.
					</h1>
					<p className="hero-sub">
						A Go-native frontend framework with fine-grained reactivity,
						direct DOM updates, and JSX-like syntax.
					</p>
					<div className="hero-actions">
						{router.Link(router.LinkProps{
							To:        "/docs",
							HTMLProps: core.HTMLProps{Class: "btn btn-primary"},
						}, "Get Started")}
						{Button(ButtonProps{
							Variant: "ghost",
							Href:    githubHref,
							Target:  "_blank",
							Rel:     "noopener noreferrer",
						}, "View on GitHub")}
					</div>
					<div className="install-row">
						<code className="install-cmd">{core.DangerousInnerHTML(HighlightCLIHTML(installCmd))}</code>
						{CopyButton(installCmd, true)}
					</div>
				</div>
				<div className="hero-pillars">
					{pillarShowcase()}
				</div>
			</div>
		</section>
	)
}
