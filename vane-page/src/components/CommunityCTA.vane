package components

import (
	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"
)

func CommunityCTA() core.Node {
	installCmd := "go install github.com/filipejohansson/vane@latest"

	return (
		<section className="section">
			<div className="cta-panel">
				<h2 className="cta-title">Built in the open.</h2>
				<p className="cta-sub">Star it, break it, send a PR.</p>
				<div className="cta-buttons">
					{router.Link(router.LinkProps{
						To:        "/docs",
						HTMLProps: core.HTMLProps{Class: "btn btn-primary"},
					}, "Get Started")}
					{Button(ButtonProps{
						Variant: "ghost",
						Href:    githubHref,
						Target:  "_blank",
						Rel:     "noopener noreferrer",
					}, "View on GitHub")}
				</div>
				<div className="install-row cta-install-row">
					<code className="install-cmd">{core.DangerousInnerHTML(HighlightCLIHTML(installCmd))}</code>
					{CopyButton(installCmd, true)}
				</div>
				<span className="cta-license">MIT License</span>
			</div>
		</section>
	)
}
