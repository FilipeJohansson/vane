#!/bin/bash
# Run the CI workflow locally before allowing a push.

if ! command -v act >/dev/null 2>&1; then
    echo "act not found - skipping local CI check (install: https://github.com/nektos/act)"
    exit 0
fi

act push -W .github/workflows/ci.yml --env ACT=true
if [ $? -ne 0 ]; then
    echo "Push canceled - local CI (act) failed"
    exit 1
fi
echo "Local CI passed - pushing"
