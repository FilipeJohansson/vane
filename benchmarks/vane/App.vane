package main

import (
	"math/rand"
	"strconv"

	"github.com/filipejohansson/vane/core"
)

// Row data generation, matching js-framework-benchmark's own word lists and
// random-pick formula (frameworks/keyed/vanillajs/src/Main.js in
// krausest/js-framework-benchmark), duplicated per framework app the same
// way that reference repo itself does.
var adjectives = []string{
	"pretty", "large", "big", "small", "tall", "short", "long", "handsome",
	"plain", "quaint", "clean", "elegant", "easy", "angry", "crazy", "helpful",
	"mushy", "odd", "unsightly", "adorable", "important", "inexpensive",
	"cheap", "expensive", "fancy",
}
var colours = []string{
	"red", "yellow", "blue", "green", "pink", "brown", "purple", "brown",
	"white", "black", "orange",
}
var nouns = []string{
	"table", "chair", "house", "bbq", "desk", "car", "pony", "cookie",
	"sandwich", "burger", "pizza", "mouse", "keyboard",
}

type Row struct {
	ID    int
	Label *core.Signal[string]
}

var nextID = 1

func buildData(count int) []Row {
	rows := make([]Row, count)
	for i := 0; i < count; i++ {
		rows[i] = Row{
			ID: nextID,
			Label: core.NewSignal(adjectives[rand.Intn(len(adjectives))] + " " +
				colours[rand.Intn(len(colours))] + " " +
				nouns[rand.Intn(len(nouns))]),
		}
		nextID++
	}
	return rows
}

func App() core.Node {
	data := core.NewList(func(r Row) string { return strconv.Itoa(r.ID) })
	selected := core.NewSignal(0)

	onSelect := func(id int) { selected.Set(id) }
	onRemove := func(id int) {
		cur := data.Items()
		next := make([]Row, 0, len(cur))
		for _, r := range cur {
			if r.ID != id {
				next = append(next, r)
			}
		}
		data.Set(next)
	}

	run := func(core.MouseEvent) {
		data.Set(buildData(1000))
		selected.Set(0)
	}
	runLots := func(core.MouseEvent) {
		data.Set(buildData(10000))
		selected.Set(0)
	}
	add := func(core.MouseEvent) {
		data.Set(append(append([]Row{}, data.Items()...), buildData(1000)...))
	}
	update := func(core.MouseEvent) {
		items := data.Items()
		for i := 0; i < len(items); i += 10 {
			items[i].Label.Set(items[i].Label.Get() + " !!!")
		}
	}
	clear := func(core.MouseEvent) {
		data.Set(nil)
		selected.Set(0)
	}
	swapRows := func(core.MouseEvent) {
		cur := data.Items()
		if len(cur) < 999 {
			return
		}
		next := append([]Row{}, cur...)
		next[1], next[998] = next[998], next[1]
		data.Set(next)
	}

	return (
		<div id="main">
			<div id="controls">
				<button id="run" onClick={run}>Create 1,000 rows</button>
				<button id="runlots" onClick={runLots}>Create 10,000 rows</button>
				<button id="add" onClick={add}>Append 1,000 rows</button>
				<button id="update" onClick={update}>Update every 10th row</button>
				<button id="clear" onClick={clear}>Clear</button>
				<button id="swaprows" onClick={swapRows}>Swap Rows</button>
			</div>
			<table>
				<tbody id="tbody">
					{for _, r := range data.Items() {
						<tr key={r.ID} className={func() string {
							if selected.Get() == r.ID {
								return "danger"
							}
							return ""
						}()}>
							<td className="col-id">{strconv.Itoa(r.ID)}</td>
							<td className="col-label">
								<a onClick={func(core.MouseEvent) { onSelect(r.ID) }}>{r.Label.Get()}</a>
							</td>
							<td className="col-remove">
								<a onClick={func(core.MouseEvent) { onRemove(r.ID) }}>x</a>
							</td>
							<td className="col-spacer"></td>
						</tr>
					}}
				</tbody>
			</table>
		</div>
	)
}
