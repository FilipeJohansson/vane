package main

import (
	"strings"
	"syscall/js"

	"vane-e2e-app/src/pages"

	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"
)

// A pathname under /hash-mode boots this fixture with HashLocation instead
// of the router's default PathLocation, so the same app/routes serve both
// the path-routing specs (router.spec.ts) and the hash-routing ones (see
// tests/e2e/specs/router-hash.spec.ts). Checked against the pathname rather
// than a query param since HashLocation.Navigate never touches the
// pathname, so the gate stays put across reloads and route changes alike.
const hashModeBase = "/hash-mode"

func App() core.Node {
	if strings.HasPrefix(js.Global().Get("location").Get("pathname").String(), hashModeBase) {
		router.SetLocation(&router.HashLocation{})
	}

	return (
		<div>
			<nav aria-label="Test pages">
				{router.Link(router.LinkProps{To: "/smoke"}, "Smoke")}
				{router.Link(router.LinkProps{To: "/rendering"}, "Rendering")}
				{router.Link(router.LinkProps{To: "/signals"}, "Signals")}
				{router.Link(router.LinkProps{To: "/events"}, "Events")}
				{router.Link(router.LinkProps{To: "/lifecycle"}, "Lifecycle")}
				{router.Link(router.LinkProps{To: "/portals"}, "Portals")}
				{router.Link(router.LinkProps{To: "/nested"}, "Nested")}
				{router.Link(router.LinkProps{To: "/errors"}, "Errors")}
				{router.Link(router.LinkProps{To: "/users/42"}, "User")}
			</nav>
			{router.Router(
				router.Route("/", pages.Smoke, router.WithTitle("Smoke - Vane E2E")),
				router.Route("/smoke", pages.Smoke, router.WithTitle("Smoke - Vane E2E")),
				router.Route("/rendering", pages.Rendering, router.WithTitle("Rendering - Vane E2E")),
				router.Route("/signals", pages.Signals, router.WithTitle("Signals - Vane E2E")),
				router.Route("/events", pages.Events, router.WithTitle("Events - Vane E2E")),
				router.Route("/lifecycle", pages.Lifecycle, router.WithTitle("Lifecycle - Vane E2E")),
				router.Route("/portals", pages.Portals, router.WithTitle("Portals - Vane E2E")),
				router.Layout("/nested", pages.NestedLayout,
					router.Route("", pages.NestedHome, router.WithTitle("Nested Home - Vane E2E")),
					router.Route("detail", pages.NestedDetail, router.WithTitle("Nested Detail - Vane E2E")),
				),
				router.Route("/errors", pages.Errors, router.WithTitle("Errors - Vane E2E")),
				router.Route("/users/:id", pages.User, router.WithTitle("User - Vane E2E")),
			)}
			<div data-testid="portal-host"></div>
		</div>
	)
}
