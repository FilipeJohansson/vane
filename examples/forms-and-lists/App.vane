package main

import (
	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"
	"github.com/filipejohansson/vane/examples/forms-and-lists/src/pages"
)

func App() core.Node {
	nav := func() core.Node {
		return (
			<nav className="nav">
				<span className="nav-brand">vane forms-and-lists</span>
				<div className="nav-links">
					{router.Link(router.LinkProps{To: "/"}, "Home")}
					{router.Link(router.LinkProps{To: "/about"}, "About")}
					{router.Link(router.LinkProps{To: "/contact"}, "Contact")}
				</div>
			</nav>
		)
	}

	routerEl := func() core.Node {
		return router.Router(
			router.Route("/", pages.Home, router.WithTitle("Home - vane forms-and-lists")),
			router.Route("/about", pages.About, router.WithTitle("About - vane forms-and-lists")),
			router.Route("/contact", pages.Contact, router.WithTitle("Contact - vane forms-and-lists")),
			router.Route("*", pages.NotFound, router.WithTitle("404 - vane forms-and-lists")),
		)
	}

	return (
		<div className="app">
			{nav()}
			<main className="main">
				{routerEl()}
			</main>
		</div>
	)
}
