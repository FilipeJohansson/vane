package main

import (
	"github.com/filipejohansson/vane/core"
	"github.com/filipejohansson/vane/core/router"
	"github.com/filipejohansson/vane/examples/fullstack-app/src/layouts"
	"github.com/filipejohansson/vane/examples/fullstack-app/src/pages"
	"github.com/filipejohansson/vane/examples/fullstack-app/src/store"
)

func App() core.Node {
	store.RestoreSession()

	return router.Router(
		router.Route("/", pages.Home, router.WithTitle("Fullstack app")),
		router.Route("/login", pages.Login, router.WithTitle("Log in")),
		router.Route("/register", pages.Register, router.WithTitle("Sign up")),
		router.Layout("/dashboard", layouts.DashboardShell,
			router.Route("", pages.Dashboard, router.WithTitle("Dashboard")),
			router.Route("users", pages.Users, router.WithTitle("Users")),
			router.Route("users/:id", pages.UserDetail, router.WithTitle("User detail")),
			router.Route("users/:id/notes", pages.UserNotes, router.WithTitle("Notes")),
		),
	)
}
